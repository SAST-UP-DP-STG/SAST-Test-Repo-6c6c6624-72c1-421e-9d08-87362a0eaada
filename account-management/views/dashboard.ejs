<div class="row g-4">
  <div class="col-12">
    <div class="d-flex align-items-center justify-content-between">
      <div>
        <h1 class="h4 mb-1">Dashboard</h1>
        <div class="text-muted small">Internal Account & Access Management System</div>
      </div>
      <div class="d-flex gap-2">
        <% if (currentUser && currentUser.role === 'admin') { %>
          <a class="btn btn-outline-secondary btn-sm" href="/users">Manage Users</a>
        <% } %>
      </div>
    </div>
  </div>

  <% if (message) { %>
    <div class="col-12">
      <div class="alert alert-info"><%= message %></div>
    </div>
  <% } %>

  <div class="col-12">
    <div class="card shadow-sm">
      <div class="card-body">
        <h2 class="h6 mb-3">Account</h2>
        <% if (user) { %>
          <div class="row g-2 small">
            <div class="col-6"><span class="text-muted">User ID</span><div><%= user.id %></div></div>
            <div class="col-6"><span class="text-muted">Role</span><div><%= user.role %></div></div>
            <div class="col-6"><span class="text-muted">Status</span><div><%= user.status %></div></div>
            <div class="col-6"><span class="text-muted">Last Login</span><div><%= user.lastLoginAt ? user.lastLoginAt.toISOString() : 'n/a' %></div></div>
            <div class="col-6"><span class="text-muted">Full Name</span><div><%= user.fullName %></div></div>
            <div class="col-6"><span class="text-muted">Email</span><div><%= user.email %></div></div>
            <div class="col-6"><span class="text-muted">Phone</span><div><%= user.phone || 'n/a' %></div></div>
            <div class="col-6"><span class="text-muted">National ID</span><div><%= user.nationalId || 'n/a' %></div></div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
